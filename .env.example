# You normally don't edit this by hand: run tools/set_key.py and it creates a file named .env for you.
# If you do it by hand, copy this file to ".env" (no ".example") and fill in the line below.

# Pixabay key (free). Sign up at pixabay.com, then it is shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional: Pexels key instead (sharper portrait video, but they sometimes pause new keys)
PEXELS_API_KEY=

# Optional but recommended: Gemini picks footage searches that fit each question (free key, no card:
# https://aistudio.google.com/apikey). Model/provider choice below is optional.
GEMINI_API_KEY=
# FOOTAGE_LLM=gemini      # gemini | claude | none  (default: Gemini if its key exists, else Claude, else none)
# GEMINI_MODEL=gemini-3.1-flash-lite
# VISION_CHECK=0          # 0 = skip the picture check (Gemini looks at candidate clips and rejects ones that do not fit)
# VISION_MIN=6            # lowest picture score (0-10) a clip needs to be used

# Optional. If set, Claude writes the questions and picks better matching video searches.
# Without it, questions come from the free Open Trivia DB.
ANTHROPIC_API_KEY=

# Optional extras
# THINK_SECONDS=8            # trivia countdown length before each answer is revealed
# THINK_PERSONALITY_SECONDS=15   # time to pick an answer in personality quizzes
# THINK_WYR_SECONDS=11          # time to choose A or B in would-you-rather videos
# VIDEO_ENCODER=h264_videotoolbox   # Mac hardware encoding (or h264_nvenc on an NVIDIA GPU)

# Disk space
# MAX_KEEP_VIDEOS=10   # keep only the newest 10 finished videos, older ones are deleted after each new video (0 = keep all)
# KEEP_CACHE=1         # keep downloaded stock clips between runs (uses lots of space)
# VIDEO_CRF=24         # lower = bigger, sharper files; 24 is a good size for TikTok

# Speed. Scenes are searched and rendered side by side (default 5); lower it if you hit rate limits.
# FOOTAGE_WORKERS=5
# Seconds between Gemini picture checks (default 4.5 stays inside the free tier). A paid key can use 1 or less.
# VISION_GAP=4.5
# On a Mac, the hardware video encoder is much faster (slightly larger files):
# VIDEO_ENCODER=h264_videotoolbox
