# You normally don't edit this by hand: run set_key.py and it creates a file named .env for you.
# If you do it by hand, copy this file to ".env" (no ".example") and fill in the line below.

# Pixabay key (free). Sign up at pixabay.com, then it is shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional: Pexels key instead (sharper portrait video, but they sometimes pause new keys)
PEXELS_API_KEY=

# Optional. If set, Claude writes the questions and picks better matching video searches.
# Without it, questions come from Open Trivia DB unless QUESTION_SOURCE selects Ollama.
ANTHROPIC_API_KEY=

# Optional: use local Gemma through Ollama for questions and footage search phrases.
# QUESTION_SOURCE=ollama
# OLLAMA_MODEL=gemma4:latest
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT=180       # seconds allowed for each model response
# VIDEO_REVIEW=1          # defaults to 1 with Ollama; set 0 to skip frame checks

# Optional extras
# THINK_SECONDS=5            # countdown length before each answer is revealed
# VIDEO_ENCODER=h264_videotoolbox   # Mac hardware encoding (or h264_nvenc on an NVIDIA GPU)

# Disk space
# MAX_KEEP_VIDEOS=10   # keep only the newest 10 finished videos (0 = keep all, the default)
# KEEP_CACHE=1         # keep downloaded stock clips between runs (uses lots of space)
# VIDEO_CRF=24         # lower = bigger, sharper files; 24 is a good size for TikTok

# VIDEO_SEARCH_ROUNDS=3   # initial searches plus 2 revised rounds; range 1-5
